# research-loop env template

# Postgres (reads from positions + strategies tables — same DB as the
# trading stack writes to)
POSTGRES_DSN=postgresql://USER:PASS@postgres:5432/control

# Redis (writes to strategy:halts SET — same Redis as strategy-runners reads)
REDIS_URL=redis://:CHANGEME@redis:6379/0

# --- Measurement window ---
WINDOW_DAYS=7

# --- Halt thresholds ---
MIN_N_CLOSED_FOR_HALT=30
MIN_DAYS_OBSERVED_FOR_HALT=7
SHARPE_HALT_THRESHOLD=0.0
CATASTROPHIC_PNL_FLOOR_USD=-200.0

# --- Cycle cadence ---
CYCLE_INTERVAL_SEC=3600   # 1 hour

# --- Halt enforcement ---
# Set to true to actually write to strategy:halts. Default false = log-only.
ENFORCE_HALTS=false

# --- Halt key (where we write) ---
HALTS_REDIS_SET=strategy:halts

# --- HTTP ---
HTTP_HOST=0.0.0.0
HTTP_PORT=8015
LOG_LEVEL=INFO
